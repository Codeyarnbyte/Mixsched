# XAMPP / Apache access control for company Wi-Fi deployment
# IMPORTANT: update the IP ranges to your actual company LAN/VPN subnets.

<IfModule mod_authz_core.c>
  # Deny by default
  Require all denied

  # Allow localhost
  Require ip 127.0.0.1 ::1

  # Allow common private network ranges (adjust/remove as needed)
  Require ip 10.0.0.0/8
  Require ip 172.16.0.0/12
  Require ip 192.168.0.0/16

  # Example fixed company subnet (replace with your real subnet)
  # Require ip 192.168.50.0/24
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Disable directory listing
Options -Indexes
